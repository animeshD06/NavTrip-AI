FROM ghcr.io/cirruslabs/flutter:3.44.0 AS build

WORKDIR /app

ARG API_BASE_URL=http://localhost:4000/api
ARG FIREBASE_API_KEY=
ARG FIREBASE_APP_ID=
ARG FIREBASE_MESSAGING_SENDER_ID=
ARG FIREBASE_PROJECT_ID=
ARG FIREBASE_AUTH_DOMAIN=
ARG FIREBASE_STORAGE_BUCKET=
ARG FIREBASE_MEASUREMENT_ID=
ARG FIREBASE_WEB_CLIENT_ID=
ARG FIREBASE_IOS_CLIENT_ID=
ARG FIREBASE_ANDROID_CLIENT_ID=
ARG FIREBASE_IOS_BUNDLE_ID=
ARG FIREBASE_APP_GROUP_ID=
ARG FIREBASE_DATABASE_URL=
ARG FIREBASE_TRACKING_ID=
ARG FIREBASE_DEEP_LINK_URL_SCHEME=

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .
RUN printf "%s\n" \
    "API_BASE_URL=${API_BASE_URL}" \
    "FIREBASE_API_KEY=${FIREBASE_API_KEY}" \
    "FIREBASE_APP_ID=${FIREBASE_APP_ID}" \
    "FIREBASE_MESSAGING_SENDER_ID=${FIREBASE_MESSAGING_SENDER_ID}" \
    "FIREBASE_PROJECT_ID=${FIREBASE_PROJECT_ID}" \
    "FIREBASE_AUTH_DOMAIN=${FIREBASE_AUTH_DOMAIN}" \
    "FIREBASE_STORAGE_BUCKET=${FIREBASE_STORAGE_BUCKET}" \
    "FIREBASE_MEASUREMENT_ID=${FIREBASE_MEASUREMENT_ID}" \
    "FIREBASE_WEB_CLIENT_ID=${FIREBASE_WEB_CLIENT_ID}" \
    "FIREBASE_IOS_CLIENT_ID=${FIREBASE_IOS_CLIENT_ID}" \
    "FIREBASE_ANDROID_CLIENT_ID=${FIREBASE_ANDROID_CLIENT_ID}" \
    "FIREBASE_IOS_BUNDLE_ID=${FIREBASE_IOS_BUNDLE_ID}" \
    "FIREBASE_APP_GROUP_ID=${FIREBASE_APP_GROUP_ID}" \
    "FIREBASE_DATABASE_URL=${FIREBASE_DATABASE_URL}" \
    "FIREBASE_TRACKING_ID=${FIREBASE_TRACKING_ID}" \
    "FIREBASE_DEEP_LINK_URL_SCHEME=${FIREBASE_DEEP_LINK_URL_SCHEME}" \
    > .env
RUN flutter build web --release --dart-define=API_BASE_URL=${API_BASE_URL}

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
